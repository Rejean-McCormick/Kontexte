{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekole:curriculum-map:1.0-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "source_registry",
    "mappings",
    "status"
  ],
  "properties": {
    "format": {
      "const": "ekole.curriculum-map/1.0-proposal"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source_registry": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "ekole_course_id",
          "official_ref",
          "mapping_status",
          "criterion"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "ekole_course_id": {
            "type": "string",
            "pattern": "^qc-pri-[a-z]+-[0-9]{3}$"
          },
          "official_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "mapping_status": {
            "enum": [
              "candidate",
              "reviewed",
              "approved",
              "rejected"
            ]
          },
          "criterion": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "const": "proposal_review_required"
    }
  }
}
